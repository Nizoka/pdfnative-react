# Dependencies
node_modules/

# Build output
dist/

# Coverage
coverage/

# Test output
test-output/

# Sample output (generated PDFs — not committed). Samples write to the
# current directory, so running them from the repo root leaves stray PDFs;
# the anchored rule catches those without touching fixtures elsewhere.
samples/output/
output.pdf
/*.pdf

# Environment files — never commit secrets
.env
.env.*
!.env.example

# OS and editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json

# npm
*.tgz
.npmrc

# AI-governance issue drafts are local work-in-progress; never commit ad-hoc
# proposals. The staging-area README and release artifacts are kept.
.github/drafts/*
!.github/drafts/README.md
!.github/drafts/pr-*.md
!.github/drafts/issue-*.md
