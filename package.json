{
  "name": "pdfnative-react",
  "version": "1.2.0",
  "description": "React renderer for pdfnative — declarative JSX components (<Document>, <Table>, <Chart>, <Barcode>…) that compile to PDF on-device with zero SaaS round-trips. Nine native vector chart types (stacked/area/scatter, log & time axes), print production (bleed, printer's marks, /Trapped), tagged PDF/A validated against veraPDF, streaming HTTP responses, 22 Unicode scripts. Built for autonomous AI agents: token-frugal DocSpec JSON grammar, capability manifest, versioned JSON Schemas, llms.txt, and a self-verification loop (lint, layout inspection, visual rasterization).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms.txt",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json --noEmit",
    "typecheck:samples": "tsc --project samples/tsconfig.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:samples",
    "verify:issue": "node scripts/verify-issue.mjs",
    "corpus:pdfa": "node scripts/generate-pdfa-corpus.mjs",
    "validate:pdfa": "npm run build && npm run corpus:pdfa && node scripts/validate-pdfa.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pdf",
    "react",
    "react-pdf",
    "pdf-generation",
    "jsx",
    "react-reconciler",
    "pdfnative",
    "zero-dependency",
    "typescript",
    "live-preview",
    "streaming",
    "outline",
    "bookmarks",
    "page-labels",
    "unicode",
    "tables",
    "barcode",
    "qrcode",
    "svg",
    "watermark",
    "pdf-a",
    "pdf-a-2b",
    "pdf-a-3b",
    "tagged-pdf",
    "archival-pdf",
    "accessibility",
    "pdf-ua",
    "verapdf",
    "linting",
    "chart",
    "charts",
    "pdf-charts",
    "vector-charts",
    "data-visualization",
    "print-production",
    "print-ready",
    "prepress",
    "bleed",
    "printer-marks",
    "output-intent",
    "on-device",
    "ssr",
    "frontend",
    "nextjs",
    "rsc",
    "edge",
    "serverless-pdf",
    "react-pdf-alternative",
    "ai-agent",
    "agentic",
    "agent-tools",
    "llm",
    "docspec",
    "capability-manifest",
    "json-output",
    "json-schema",
    "llms-txt",
    "rag",
    "mcp",
    "automation",
    "ai-governance",
    "hitl",
    "human-in-the-loop",
    "responsible-ai",
    "agent-safety",
    "sbom",
    "supply-chain",
    "invoice"
  ],
  "author": "Nizoka <hello@pdfnative.dev> (https://pdfnative.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nizoka/pdfnative-react.git"
  },
  "homepage": "https://github.com/Nizoka/pdfnative-react#readme",
  "bugs": {
    "url": "https://github.com/Nizoka/pdfnative-react/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://plika.app"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "pdfnative": "^1.7.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "react-reconciler": "^0.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-reconciler": "^0.32.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "pdfnative": "^1.7.0",
    "react": "^19.0.0",
