{
  "name": "pdfnative-react",
  "version": "1.3.0",
  "description": "React renderer for pdfnative — declarative JSX components (<Document>, <Table>, <Chart>, <Barcode>…) that compile to PDF on-device with zero SaaS round-trips. Fine typography (widows/orphans, justification, kerning, OpenType features), CMYK colour and PDF/X-4 print output, nine native vector chart types, tagged PDF/A validated against veraPDF, byte-reproducible rendering, streaming HTTP responses, 27 Unicode scripts. Built for autonomous AI agents: token-frugal DocSpec JSON grammar, capability manifest, versioned JSON Schemas, llms.txt, and a self-verification loop (lint, layout inspection, PDF/X and PDF/UA checks, visual rasterization).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gate": "npx tsx scripts/gate.ts",
    "gate:fast": "npx tsx scripts/gate.ts --fast",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json --noEmit",
    "typecheck:samples": "tsc --project samples/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "typecheck:compat": "tsc --project tests/regression/compat/tsconfig.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:samples && npm run typecheck:scripts && npm run typecheck:compat",
    "test:generate": "npx tsx scripts/generate-samples.ts",
    "verify:samples": "npx tsx scripts/verify-samples.ts",
    "verify:docs": "npx tsx scripts/verify-docs.ts",
    "verify:issue": "node scripts/verify-issue.mjs",
    "corpus:pdfa": "npx tsx scripts/generate-pdfa-corpus.ts",
    "validate:pdfa": "npx tsx scripts/validate-pdfa.ts",
    "validate:pdfx": "npx tsx scripts/validate-pdfx.ts",
    "release:prepare": "npx tsx scripts/release-prepare.ts",
    "agents:rules": "npx tsx scripts/build-claude-rules.ts",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "hooks:uninstall": "node scripts/install-git-hooks.mjs --uninstall",
    "prepublishOnly": "npm run build"
  },
